NODE_ENV=development
PORT=3355
DATABASE_URL=postgresql://smg:smg123@localhost:5433/smg_agendamentos?schema=public

JWT_SECRET=troque-esta-chave
JWT_EXPIRES_IN=7d

# URLs publicas (links enviados ao cliente, webhooks e OAuth)
PUBLIC_APP_URL=http://localhost:5176
PUBLIC_API_URL=http://localhost:3355

# Pagamentos (gateway SMG -> Mercado Pago). Sem token, roda em modo SIMULADO.
# O token tambem pode ser configurado por estabelecimento em Configuracoes > Pagamentos.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
GATEWAY_TAXA_PIX_PCT=0.99
GATEWAY_TAXA_CARTAO_PCT=4.98
RESERVA_MINUTOS=15

# Agentes de IA (OpenAI via LangChain, igual ao Gestor SMG varejo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_BUFFER_SECONDS=6
AGENT_HISTORY_LIMIT=30

# WhatsApp: credenciais ficam por estabelecimento (aba Agentes de IA). Base URL padrao da Uazapi:
UAZAPI_BASE_URL=
# true = nao envia mensagens de verdade (apenas registra)
WHATSAPP_DRY_RUN=false

# Google Calendar (OAuth). Redirect URI: {PUBLIC_API_URL}/api/integracoes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SYNC_MINUTES=10

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
SEED_DEMO=true
